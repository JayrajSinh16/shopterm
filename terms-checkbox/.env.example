# Shopify App Credentials (from Partners Dashboard)
SHOPIFY_API_KEY="your_api_key_here"
SHOPIFY_API_SECRET="your_api_secret_here"

# Scopes your app needs
SCOPES="read_orders,read_customers,write_customers"

# Your app's public URL (ngrok/cloudflare tunnel URL for dev, production URL for prod)
HOST="https://your-app-url.ngrok-free.app"

# Database
# For development (SQLite):
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Shopify App Proxy
# After configuring proxy in Partners Dashboard, this is auto-set
# The storefront will POST to: https://your-store.myshopify.com/apps/tc-consent
