# Shopify App Credentials (from Partners Dashboard)
SHOPIFY_API_KEY="your_api_key_here"
SHOPIFY_API_SECRET="your_api_secret_here"

# Scopes
SCOPES="read_orders,read_customers"

# Your app's public URL (Railway production URL, or tunnel URL for dev)
SHOPIFY_APP_URL="https://your-app.up.railway.app"
HOST="https://your-app.up.railway.app"

# Database
# Railway auto-injects DATABASE_URL when you link a Postgres service.
# For local dev, use a local PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:password@localhost:5432/terms_checkbox"

# Node environment
NODE_ENV="production"
